      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに送信されている場合は重複します。まずTogglの記録を確認してください。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrying an already delivered entry creates a duplicate. Check Toggl first."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторная отправка уже принятой записи создаст дубликат. Сначала проверьте Toggl."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果记录已经发送，重试会产生重复记录。请先查看 Toggl。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果記錄已經傳送，重試會產生重複記錄。請先查看 Toggl。"
          }
        }
      }
    },
    "タスクの取り込みや集中時間の共有に使うサービスを選べます。" : {
