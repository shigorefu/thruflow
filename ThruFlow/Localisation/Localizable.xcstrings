          }
        }
      }
    },
    "タスク、方向、タスクのメモは残ります。チェック済みタスクの状態も変更されません。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasks, areas, and task notes will remain. Completed tasks will stay completed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクと分野、タスクに付けたメモは削除されません。チェック済みの状態もそのまま残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задачи, сферы и заметки к задачам останутся. Статус выполненных задач не изменится."
          }
        }
      }
    },
    "タスク%lld件・集中%lld回" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
