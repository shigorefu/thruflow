    "流れ" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流れ"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow"
          }
        }
      }
    },
    "流れは、今日の作業を進める中心の画面です。集中タイマー、今日のタスク、作業の流れ、今日の統計をまとめて確認できます。途中でタスクや長さを変えても、途切れない作業はひとつの流れとして残ります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow is the main workspace for getting today's work done. It brings together the focus timer, today's Tasks, your timeline, and today's Statistics. You can switch Tasks or duration along the way; uninterrupted work remains one Flow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流れは、今日の作業を進める中心の画面です。集中タイマー、今日のタスク、作業の流れ、今日の統計をまとめて確認できます。途中でタスクや長さを変えても、途切れない作業はひとつの流れとして残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow — главный экран для работы на сегодня. Здесь собраны таймер фокуса, задачи на сегодня, шкала времени и статистика за день. Можно менять задачу или длительность: непрерывная работа всё равно сохранится как один Flow."
          }
        }
      }
    },
    "満ちている流れ" : {
