    "取り組むタスク" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Task to Focus On"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り組むタスク"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задача для фокуса"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要专注的任务"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要專注的任務"
          }
        }
      }
    },
    "取り組むタスクと集中時間を選び、準備ができたら再生ボタンを押します。途中で変更しても、途切れない作業はひとつのフローとして残ります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what to work on and how long to focus, then press Play. You can change either during a session without splitting continuous work."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り組むタスクと集中時間を選び、準備ができたら再生ボタンを押します。途中で変更しても、途切れない作業はひとつのフローとして残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите задачу и длительность, затем нажмите Play. Их можно менять во время работы — непрерывная сессия останется одной записью Flow."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要做的任务和专注时长，准备好后按播放按钮。你可以在过程中修改，连续的工作仍会保留为同一次专注。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要做的任務和專注時長，準備好後按播放按鈕。你可以在過程中修改，連續的工作仍會保留為同一次專注。"
          }
        }
      }
    },
