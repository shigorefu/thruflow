{
  "sourceLanguage" : "ja",
  "strings" : {
    "この分野をアーカイブしますか？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive this area?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この分野をアーカイブしますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивировать эту сферу?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要归档此领域吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要封存此領域嗎？"
          }
        }
      }
    },
    "プロジェクト名を入力してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a project name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト名を入力してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите название проекта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入项目名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入專案名稱。"
          }
        }
      }
    },
    "アーカイブされていない分野を選んでください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an area that is not archived."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブされていない分野を選んでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сферу, которая не находится в архиве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择未归档的领域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇未封存的領域。"
          }
        }
      }
    },
    "プロジェクトの分野は変更できません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project cannot be moved to another area."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトの分野は変更できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проект нельзя перенести в другую сферу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将项目移至其他领域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將專案移至其他領域。"
          }
        }
      }
    },
    "進行中のプロジェクトを選んでください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an active project."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中のプロジェクトを選んでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите незавершённый проект."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择进行中的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇進行中的專案。"
          }
        }
      }
    },
    "選択した分野のプロジェクトを選んでください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a project in the selected area."
