    "時間に余裕があるときに取り組みたいこと向けです。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For things you would like to do when you have some time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間に余裕があるときに取り組みたいこと向けです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для дел, которыми хочется заняться, если останется время."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于有空时想做的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於有空時想做的事。"
          }
        }
      }
    },
    "時間の使い方に気づき、次に何へ取り組むかを決めるための統計です。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Statistics to notice where your time goes and decide what to focus on next."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間の使い方に気づき、次に何へ取り組むかを決めるための統計です。"
          }
        },
        "ru" : {
          "stringUnit" : {
