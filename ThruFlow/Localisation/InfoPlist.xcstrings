    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したリストのリマインダーを取り込み、完了・未完了をThruFlowと同期するために使用します。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import reminders from selected lists and sync completion and reopening with ThruFlow."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импорт напоминаний из выбранных списков и синхронизация выполнения и повторного открытия с ThruFlow."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于导入所选列表中的提醒事项，并与 ThruFlow 同步完成和重新打开状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於匯入所選清單中的提醒事項，並與 ThruFlow 同步完成和重新開啟狀態。"
          }
        }
      }
    }
  },
  "version" : "1.0"
