# frozen_string_literal: true

require_relative "lib/testflight_support"

ROOT = File.expand_path("..", __dir__)

# Shared implementation; the workflow runs one platform in each fresh hosted runner.
private_lane :upload_candidate do |options|
  platform = options.fetch(:platform)
  config = TestFlightSupport.configuration(ENV, platform)
  output = File.join(ROOT, "build", "testflight", platform)
  archive = File.join(output, "ThruFlow.xcarchive")
  keychain = "thruflow-testflight-#{SecureRandom.hex(12)}"
  password = SecureRandom.hex(32)
  # GitHub masks the generated password before any action can print it.
  puts "::add-mask::#{password}"
  begin
    create_keychain(name: keychain, password: password, default_keychain: false,
                    unlock: true, timeout: 7200, lock_when_sleeps: true,
                    add_to_search_list: true)
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"), is_key_content_base64: true,
      duration: 1200, in_house: false
    )
    match(type: "appstore", platform: platform, readonly: true,
          storage_mode: "git", git_url: ENV.fetch("MATCH_GIT_URL"),
          git_branch: ENV.fetch("MATCH_GIT_BRANCH"),
          git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"].to_s.empty? ? nil : ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
          git_private_key: ENV["MATCH_GIT_PRIVATE_KEY"].to_s.empty? ? nil : ENV["MATCH_GIT_PRIVATE_KEY"],
          app_identifier: TestFlightSupport::TARGETS.fetch(platform).values,
          team_id: config[:team], api_key: api_key,
          keychain_name: keychain, keychain_password: password,
          additional_cert_types: platform == "macos" ? ["mac_installer_distribution"] : [])
    signing = TestFlightSupport.signing_settings(ENV, platform)
    profiles = signing.values.to_h { |item| [item[:identifier], item[:profile]] }
    TestFlightSupport.with_project_copy(ROOT) do |project|
      signing.each do |target, settings|
        update_code_signing_settings(path: project, use_automatic_signing: false,
                                     targets: [target], build_configurations: ["Release"],
                                     team_id: config[:team], code_sign_identity: settings[:certificate],
                                     profile_name: settings[:profile])
      end
      build_app(project: project,
                scheme: platform == "ios" ? "ThruFlow iOS" : "ThruFlow",
                configuration: "Release", clean: true,
                destination: platform == "ios" ? "generic/platform=iOS" : "generic/platform=macOS",
                archive_path: archive, derived_data_path: File.join(output, "DerivedData"),
                buildlog_path: File.join(output, "logs"), output_directory: output,
                output_name: "ThruFlow-#{config[:version]}-#{config[:build]}",
                export_method: "app-store", export_team_id: config[:team],
                installer_cert_name: config[:installer], skip_profile_detection: true,
                export_options: { signingStyle: "manual", provisioningProfiles: profiles,
                                  manageAppVersionAndBuildNumber: false,
                                  iCloudContainerEnvironment: "Production", destination: "export" },
                xcodebuild_formatter: "", xcargs: "COMPILER_INDEX_STORE_ENABLE=NO")
    end
    TestFlightSupport.validate_bundles!(File.join(archive, "Products", "Applications"), config, signed: false)
    artifact = lane_context[platform == "ios" ? SharedValues::IPA_OUTPUT_PATH : SharedValues::PKG_OUTPUT_PATH]
    TestFlightSupport.validate_export!(artifact, config)
    upload_to_testflight(api_key: api_key, app_identifier: TestFlightSupport::APP_ID,
                         apple_id: "6798609191", app_platform: platform == "ios" ? "ios" : "osx",
                         ipa: platform == "ios" ? artifact : nil,
                         pkg: platform == "macos" ? artifact : nil,
                         app_version: config[:version], build_number: config[:build],
                         skip_submission: true, skip_waiting_for_build_processing: false,
                         distribute_external: false, notify_external_testers: false,
                         submit_beta_review: false, wait_processing_interval: 30,
                         wait_processing_timeout_duration: 1800)
  ensure
    delete_keychain(name: keychain)
  end
end

platform :ios do
  desc "Archive and upload the approved iOS/Watch candidate without distributing it"
  lane :beta do
    upload_candidate(platform: "ios")
  end
end

platform :mac do
  desc "Archive and upload the approved macOS candidate without distributing it"
  lane :beta do
    upload_candidate(platform: "macos")
  end
end
